# MongoDB: same server as UnieWMS. One database holds all UnieCourier data.
# Use the same connection host (and credentials) as UnieWMS; the database name is set below.
MONGODB_URI=mongodb://localhost:27017/uniewms

# Database name for this platform. All UnieCourier data (hubs, drivers, states, users, etc.) lives here.
# Create this database on the server, or it will be created on first write. Default: uniecourier
# UNIECOURIER_DB_NAME=uniecourier

# Database where UnieWMS stores warehouses (collection "warehouses"). Must match your MongoDB DB name exactly (case-sensitive). Default: uniewms
# UNIEWMS_DB_NAME=uniewms

# Optional: full MongoDB URI for the server/database that has the warehouses collection. Use if warehouses are on a different server than MONGODB_URI, or if the DB name differs (e.g. UnieWMS). Example: mongodb://localhost:27017/UnieWMS
# UNIEWMS_MONGODB_URI=
